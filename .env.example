# Copy to .env and fill in what you use. Nothing here is required for a --mock build.

# Script planning (vf plan) and fact-check review (vf review)
ANTHROPIC_API_KEY=
VF_PLANNER_MODEL=claude-opus-5-5
VF_PLANNER_EFFORT=high

# Narration + background music
ELEVENLABS_API_KEY=

# AI images + AI video clips (one key, hundreds of models)
FAL_KEY=

# Optional alternates
OPENAI_API_KEY=
PEXELS_API_KEY=

# YouTube publishing (see docs/YOUTUBE.md for the one-time OAuth setup)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Rendering
# Path to a Chrome/Chromium binary if Remotion can't download its own headless shell
REMOTION_BROWSER_EXECUTABLE=
# Number of parallel frame renderers (defaults to half your cores)
REMOTION_CONCURRENCY=
# Only needed if your company needs a Remotion company license (4+ people)
REMOTION_LICENSE_KEY=

# Where generated assets are cached (default: ./.vf-cache)
VF_CACHE_DIR=
